# python app.py bu dosyanın .env adlı kopyasını okur.
# Mevcut .env dosyanızın üzerine yazmayın; kişisel verileri ve anahtarları Git'e eklemeyin.
# Göreli yollar proje dizininden çözülür.
YOKLAMAX_MODE=recognition
YOKLAMAX_DEMO=0
YOKLAMAX_DATA_DIR=data/live
# Kendi fotoğraf klasörünüz farklıysa yalnız yerel .env dosyasında değiştirin.
YOKLAMAX_FACES_DIR=faces
YOKLAMAX_PORT=5050
# Boş bırakılırsa her başlangıçta bellekte rastgele oturum anahtarı oluşturulur.
# Sunucu yeniden açılınca aynı tarayıcı oturumunu korumak için gizli bir değer kullanın.
YOKLAMAX_SECRET_KEY=
